# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=yijing_oracle

# JWT密钥
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# 微信开放平台配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# 短信服务配置（阿里云）
SMS_ACCESS_KEY_ID=your_aliyun_access_key_id
SMS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
SMS_SIGN_NAME=易经卜卦
SMS_TEMPLATE_CODE=SMS_123456789

# 或使用腾讯云短信
# TENCENT_SECRET_ID=your_tencent_secret_id
# TENCENT_SECRET_KEY=your_tencent_secret_key
# TENCENT_SMS_APP_ID=your_sms_app_id
# TENCENT_SMS_SIGN=易经卜卦
# TENCENT_SMS_TEMPLATE_ID=123456

# 邮件服务配置（用于邮箱验证）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=your_email@qq.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=易经卜卦 <your_email@qq.com>

# 前端地址（CORS）
CLIENT_URL=http://localhost:5173

# AI服务配置（可选）
OPENAI_API_KEY=your_openai_api_key
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
