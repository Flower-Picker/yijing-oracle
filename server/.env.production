# ===== 生产环境配置 =====
# 请根据实际情况修改以下配置

# 服务器配置
PORT=3000
NODE_ENV=production

# 数据库类型（生产环境使用MySQL）
DB_TYPE=mysql

# MySQL数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=yijing_user
DB_PASSWORD=请修改为安全密码
DB_NAME=yijing_oracle

# JWT密钥（必须修改！使用随机字符串）
JWT_SECRET=请修改为随机生成的32位以上安全字符串
JWT_EXPIRE=7d

# 短信服务配置
# 选项1: 阿里云短信
SMS_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
ALIYUN_SMS_SIGN=易经卜卦
ALIYUN_SMS_TEMPLATE=SMS_xxxxxxxx

# 选项2: 腾讯云短信（如果使用腾讯云，取消下面的注释并注释掉阿里云配置）
# SMS_PROVIDER=tencent
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SMS_APP_ID=
# TENCENT_SMS_SIGN=易经卜卦
# TENCENT_SMS_TEMPLATE_ID=

# 微信开放平台配置
WECHAT_APP_ID=你的微信AppID
WECHAT_APP_SECRET=你的微信AppSecret
WECHAT_REDIRECT_URI=https://你的域名.com/api/auth/wechat/callback

# 邮件服务配置（用于邮箱验证）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=你的邮箱@qq.com
EMAIL_PASSWORD=邮箱授权码
EMAIL_FROM=易经卜卦 <你的邮箱@qq.com>

# 前端地址（CORS配置 - 重要！）
CLIENT_URL=https://flower-picker.github.io

# AI服务配置（OpenAI或其他兼容API）
OPENAI_API_KEY=你的OpenAI_API_Key
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# 或使用国内API（如果有）
# AI_API_ENDPOINT=https://your-chinese-api.com/v1/chat/completions
